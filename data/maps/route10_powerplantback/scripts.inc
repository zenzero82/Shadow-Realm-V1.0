route10_powerplantback_MapScripts::
	map_script MAP_SCRIPT_ON_LOAD, route10_powerplantback_EventScript_SyncPlasmaCleanup
	map_script MAP_SCRIPT_ON_TRANSITION, route10_powerplantback_EventScript_SyncPlasmaCleanup
	.byte 0

route10_powerplantback_EventScript_SyncPlasmaCleanup::
	checktrainerflag TRAINER_ZINZOLIN_POWER_PLANT
	goto_if_eq route10_powerplantback_EventScript_SyncPlasmaCleanup_Hide
	setflag FLAG_ROUTE10_POWERPLANT_INVASION_ACTIVE
	goto route10_powerplantback_EventScript_SyncPlasmaCleanup_Show

route10_powerplantback_EventScript_SyncPlasmaCleanup_Hide::
	clearflag FLAG_ROUTE10_POWERPLANT_INVASION_ACTIVE
	setflag FLAG_HIDE_ROUTE10_POWERPLANT_PLASMA_3
	hideobjectat LOCALID_ROUTE10_POWERPLANTBACK_PLASMA_GRUNT_3, MAP_ROUTE10_POWERPLANTBACK
	removeobject LOCALID_ROUTE10_POWERPLANTBACK_PLASMA_GRUNT_3
route10_powerplantback_EventScript_SyncPlasmaCleanup_Done::
	end

route10_powerplantback_EventScript_SyncPlasmaCleanup_Show::
	clearflag FLAG_HIDE_ROUTE10_POWERPLANT_PLASMA_3
	addobject LOCALID_ROUTE10_POWERPLANTBACK_PLASMA_GRUNT_3
	showobjectat LOCALID_ROUTE10_POWERPLANTBACK_PLASMA_GRUNT_3, MAP_ROUTE10_POWERPLANTBACK
	end

route10_powerplantback_EventScript_PlasmaGrunt3::
	setspeaker route10_powerplantback_Speaker_PlasmaGrunt
	trainerbattle_single TRAINER_POWERPLANT_PLASMA_3, route10_powerplantback_Text_PlasmaGrunt3_Intro, route10_powerplantback_Text_PlasmaGrunt3_Defeat, route10_powerplantback_EventScript_PlasmaGrunt3_After
	goto route10_powerplantback_EventScript_PlasmaGrunt3_After
	end

route10_powerplantback_EventScript_PlasmaGrunt3_After::
	settrainerflag TRAINER_POWERPLANT_PLASMA_3
	setspeaker route10_powerplantback_Speaker_PlasmaGrunt
	msgbox route10_powerplantback_Text_PlasmaGrunt3_After, MSGBOX_DEFAULT
	releaseall
	end

route10_powerplantback_EventScript_Voltorb1::
	lock
	faceplayer
	setwildbattle SPECIES_VOLTORB, 30
	waitse
	playmoncry SPECIES_VOLTORB, CRY_MODE_NORMAL
	delay 40
	waitmoncry
	setflag FLAG_SYS_CTRL_OBJ_DELETE
	dowildbattle
	clearflag FLAG_SYS_CTRL_OBJ_DELETE
	specialvar VAR_RESULT, GetBattleOutcome
	goto_if_eq VAR_RESULT, B_OUTCOME_WON, route10_powerplantback_EventScript_Voltorb1_Done
	goto_if_eq VAR_RESULT, B_OUTCOME_RAN, route10_powerplantback_EventScript_Voltorb1_Done
	goto_if_eq VAR_RESULT, B_OUTCOME_PLAYER_TELEPORTED, route10_powerplantback_EventScript_Voltorb1_Done
route10_powerplantback_EventScript_Voltorb1_Done::
	setflag FLAG_HIDE_POWERPLANTBACK_VOLTORB_1
	goto Common_EventScript_RemoveStaticPokemon
	end

