+static u8 StartMenuBW_GetMaxScrollOffset(void)
+{
+    u8 rows = (sNumStartMenuActions + START_MENU_COLUMNS - 1) / START_MENU_COLUMNS;
+    if (rows <= START_MENU_ROWS)
+        return 0;
+    return rows - START_MENU_ROWS;
+}
